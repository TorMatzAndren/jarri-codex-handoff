#!/usr/bin/env python3
"""Render a Codex handoff transcript and send it to external catcopy."""

import argparse
import shutil
import subprocess
import sys
from pathlib import Path


def renderer():
    sibling = Path(__file__).resolve().with_name("codex-handoff-render")
    if sibling.is_file() and sibling.stat().st_mode & 0o111:
        return str(sibling)
    found = shutil.which("codex-handoff-render")
    if not found:
        print("codex-handoff-copy: codex-handoff-render is not installed", file=sys.stderr)
        raise SystemExit(127)
    return found


def main():
    parser = argparse.ArgumentParser(prog="codex-handoff-copy")
    parser.add_argument("selection", nargs="?", type=int, help="repo-local historical selection")
    parser.add_argument("--list", action="store_true", help="list matching sessions")
    parser.add_argument("--thread")
    parser.add_argument("--turn")
    args = parser.parse_args()

    exact = args.thread is not None or args.turn is not None
    if (args.thread is None) != (args.turn is None) or (exact and (args.list or args.selection is not None)):
        parser.error("use --thread THREAD_ID --turn TURN_ID by itself")
    if args.list and args.selection is not None:
        parser.error("--list cannot be combined with a selection")

    render_args = [renderer()]
    if exact:
        render_args.extend(["--session-id", args.thread, "--through-turn", args.turn])
    elif args.list:
        render_args.append("--list")
    elif args.selection is not None:
        render_args.append(str(args.selection))

    rendered = subprocess.run(render_args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if rendered.returncode:
        sys.stderr.write(rendered.stderr)
        return rendered.returncode
    if args.list:
        sys.stdout.write(rendered.stdout)
        return 0

    if exact:
        label = f"CODEX:thread:{args.thread}:turn:{args.turn}"
        success = f"Copied Codex thread {args.thread} through turn {args.turn}."
    else:
        selection = str(args.selection) if args.selection is not None else "0"
        label = f"CODEX:thisrepo:{selection}"
        success = f"Copied Codex session {selection} for current repository."
    payload = ("===== TRANSPORT HEADER (NOT PART OF FILE) =====\n"
               f"PATH: {label}\n"
               "NOTE: Do NOT include this header in any saved documents.\n"
               "===============================================\n" + rendered.stdout)
    catcopy = shutil.which("catcopy")
    if not catcopy:
        print("codex-handoff-copy: external catcopy command not found in PATH", file=sys.stderr)
        return 127
    copied = subprocess.run([catcopy], input=payload, text=True)
    if copied.returncode == 0:
        print(success)
    return copied.returncode


if __name__ == "__main__":
    raise SystemExit(main())
