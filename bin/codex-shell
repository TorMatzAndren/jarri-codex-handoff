#!/usr/bin/env bash
set -euo pipefail

CODEX_BIN="${CODEX_BIN:-codex}"

if ! command -v "$CODEX_BIN" >/dev/null 2>&1; then
    echo "codex-shell: Codex CLI was not found: $CODEX_BIN" >&2
    echo "Install Codex or set CODEX_BIN to its executable." >&2
    exit 127
fi

SCRIPT_PATH="$(readlink -f -- "$0")"
BINDIR="$(dirname -- "$SCRIPT_PATH")"

HOOK="$BINDIR/codex-handoff-notify"
COPY="$BINDIR/codex-handoff-copy"
RENDERER="$BINDIR/codex-handoff-render"
WATCHER="$BINDIR/codex-handoff-watch"

for required in "$HOOK" "$COPY" "$RENDERER" "$WATCHER"; do
    if [[ ! -x "$required" ]]; then
        echo "codex-shell: required package command is missing: $required" >&2
        exit 127
    fi
done

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CONFIG="$CODEX_HOME/config.toml"

mkdir -p "$CODEX_HOME"

CONFIG_RESULT="$(
python3 - "$CONFIG" "$HOOK" <<'PY'
from pathlib import Path
import json
import re
import sys

path = Path(sys.argv[1])
hook = Path(sys.argv[2]).resolve()

if path.exists():
    text = path.read_text(encoding="utf-8")
else:
    text = ""

# ---------------------------------------------------------------------------
# Top-level notify ownership
#
# Do not silently destroy another tool's notification hook. If a user already
# owns `notify`, preserve it and report the conflict to codex-shell.
# ---------------------------------------------------------------------------

desired_notify = f"notify = [{json.dumps(str(hook))}]"
notify_re = re.compile(r'(?m)^notify\s*=.*$')
notify_match = notify_re.search(text)

if notify_match:
    current_notify = notify_match.group(0).strip()

    if current_notify == desired_notify:
        notify_status = "already-configured"
    else:
        notify_status = "conflict"
else:
    if text and not text.endswith("\n"):
        text += "\n"

    text = desired_notify + "\n" + text
    notify_status = "configured"

# ---------------------------------------------------------------------------
# TUI presentation
# ---------------------------------------------------------------------------

section_re = re.compile(
    r'(?ms)^\[tui\]\s*\n(?P<body>.*?)(?=^\[[^\n]+\]\s*$|\Z)'
)

match = section_re.search(text)

required = {
    "raw_output_mode": "true",
    "alternate_screen": '"never"',
}

if match:
    body = match.group("body")

    for key, value in required.items():
        key_re = re.compile(
            rf'(?m)^\s*{re.escape(key)}\s*=.*$'
        )

        if key_re.search(body):
            body = key_re.sub(
                f"{key} = {value}",
                body,
                count=1,
            )
        else:
            if body and not body.endswith("\n"):
                body += "\n"
            body += f"{key} = {value}\n"

    replacement = "[tui]\n" + body
    text = text[:match.start()] + replacement + text[match.end():]

else:
    if text and not text.endswith("\n"):
        text += "\n"

    if text:
        text += "\n"

    text += (
        "[tui]\n"
        "raw_output_mode = true\n"
        'alternate_screen = "never"\n'
    )

path.write_text(text, encoding="utf-8")

print(notify_status)
PY
)"

cat <<BANNER
Jarri Codex Handoff Shell
-------------------------
Codex remains the normal upstream Codex CLI.

Codex TUI settings ensured:
  raw_output_mode = true
  alternate_screen = "never"

BANNER

case "$CONFIG_RESULT" in
    configured)
        cat <<BANNER
Automatic handoff enabled:
  each completed Codex turn is copied to the clipboard
  from the canonical repo-scoped Codex JSONL session.

BANNER
        ;;
    already-configured)
        cat <<BANNER
Automatic handoff already configured:
  each completed Codex turn is copied to the clipboard.

BANNER
        ;;
    conflict)
        cat <<BANNER
Automatic handoff NOT enabled:
  an existing Codex 'notify' setting was preserved.

Jarri would use:
  notify = ["$HOOK"]

Resolve that ownership manually if you want automatic handoff.

BANNER
        ;;
esac

# The watcher is independent of Codex's legacy notify callback. It holds a
# per-user lock, so launching another Codex shell does not create another loop.
nohup "$WATCHER" >/dev/null 2>&1 </dev/null &

cat <<'BANNER'
Manual handoff remains available:
  codex-handoff-copy                 copy newest repo-local session
  codex-handoff-copy 1               copy previous session
  codex-handoff-copy --list          list repo-local sessions
  codex-handoff-copy --thread ID --turn ID

Clipboard delivery requires external catcopy, which owns c and catcopy.

BANNER

exec "$CODEX_BIN" "$@"
