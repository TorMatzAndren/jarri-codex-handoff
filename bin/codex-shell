#!/usr/bin/env bash
set -euo pipefail

if ! command -v codex >/dev/null 2>&1; then
    echo "codex-shell: Codex CLI was not found in PATH." >&2
    echo "Install Codex first, then run codex-shell again." >&2
    exit 127
fi

if ! command -v c >/dev/null 2>&1; then
    echo "codex-shell: catcopy/c is not installed correctly." >&2
    exit 127
fi

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CONFIG="$CODEX_HOME/config.toml"

mkdir -p "$CODEX_HOME"

python3 - "$CONFIG" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])

if path.exists():
    text = path.read_text(encoding="utf-8")
else:
    text = ""

section_re = re.compile(
    r'(?ms)^\[tui\]\s*\n(?P<body>.*?)(?=^\[[^\n]+\]\s*$|\Z)'
)

match = section_re.search(text)

required = {
    "raw_output_mode": "true",
    "alternate_screen": '"never"',
}

if match:
    body = match.group("body")

    for key, value in required.items():
        key_re = re.compile(
            rf'(?m)^\s*{re.escape(key)}\s*=.*$'
        )

        if key_re.search(body):
            body = key_re.sub(
                f"{key} = {value}",
                body,
                count=1,
            )
        else:
            if body and not body.endswith("\n"):
                body += "\n"
            body += f"{key} = {value}\n"

    replacement = "[tui]\n" + body
    text = text[:match.start()] + replacement + text[match.end():]

else:
    if text and not text.endswith("\n"):
        text += "\n"

    if text:
        text += "\n"

    text += (
        "[tui]\n"
        "raw_output_mode = true\n"
        'alternate_screen = "never"\n'
    )

path.write_text(text, encoding="utf-8")
PY

cat <<'BANNER'
Jarri Codex Handoff Shell
-------------------------
Codex remains the normal upstream Codex CLI.

Codex TUI settings ensured:
  raw_output_mode = true
  alternate_screen = "never"

After a Codex task:
  c thisrepo        copy newest session for this Git repository
  c thisrepo 1      copy previous session
  c thisrepo list   list available repo-local Codex sessions

Normal catcopy:
  c file.txt
  cat file.txt | c
BANNER

exec codex "$@"
