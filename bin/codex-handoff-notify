#!/usr/bin/env bash
set -u

PAYLOAD="${1:-}"

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/jarri-codex-handoff"
LOG_FILE="$LOG_DIR/notify.log"
LOG_BACKUP="$LOG_DIR/notify.log.1"
LOG_MAX_BYTES=$((1024 * 1024))

mkdir -p "$LOG_DIR" 2>/dev/null || true

if [[ -f "$LOG_FILE" ]]; then
    LOG_SIZE="$(stat -c '%s' "$LOG_FILE" 2>/dev/null || printf '0')"

    if [[ "$LOG_SIZE" =~ ^[0-9]+$ ]] && (( LOG_SIZE >= LOG_MAX_BYTES )); then
        mv -f -- "$LOG_FILE" "$LOG_BACKUP" 2>/dev/null || true
    fi
fi

{
    printf '%s pid=%s event=invoked payload_bytes=%s cwd=%q display=%q\n' \
        "$(date --iso-8601=ns)" \
        "$$" \
        "${#PAYLOAD}" \
        "${PWD:-}" \
        "${DISPLAY:-}"
} >>"$LOG_FILE" 2>/dev/null || true

SCRIPT_PATH="$(readlink -f -- "$0")"
BINDIR="$(dirname -- "$SCRIPT_PATH")"
CATCOPY="$BINDIR/catcopy"

if [[ ! -x "$CATCOPY" ]]; then
    echo "codex-handoff-notify: catcopy not found beside notify helper." >&2
    exit 127
fi

eval "$(
    python3 - "$PAYLOAD" <<'PAYLOAD_PY'
import json
import shlex
import sys

try:
    obj = json.loads(sys.argv[1])
except Exception:
    obj = {}

values = {
    "EVENT_TYPE": obj.get("type", ""),
    "CWD": obj.get("cwd", ""),
    "THREAD_ID": obj.get("thread-id", ""),
    "TURN_ID": obj.get("turn-id", ""),
}

for key, value in values.items():
    print(f"{key}={shlex.quote(str(value))}")
PAYLOAD_PY
)"

log_record() {
    printf '%s pid=%s process_cwd=%q payload_cwd=%q thread_id=%q turn_id=%q %s\n' \
        "$(date --iso-8601=ns)" "$$" "${PWD:-}" "$CWD" \
        "$THREAD_ID" "$TURN_ID" "$1" >>"$LOG_FILE" 2>/dev/null || true
}

# Codex may grow other notification event types. They are not handoff events.
if [[ "$EVENT_TYPE" != "agent-turn-complete" ]]; then
    log_record "event=ignored type=$EVENT_TYPE status=skip reason=non_agent_turn_complete"
    exit 0
fi

if [[ -z "$CWD" || ! -d "$CWD" ]]; then
    log_record "event=ignored status=skip reason=invalid_cwd"
    exit 0
fi

# The payload directory must identify a Git repository.
if ! git -C "$CWD" rev-parse --show-toplevel >/dev/null 2>&1; then
    log_record "event=ignored status=skip reason=not_git_repository"
    exit 0
fi

if [[ -z "$THREAD_ID" ]]; then
    log_record "event=ignored status=skip reason=missing_thread_id"
    exit 0
fi

if [[ -z "$TURN_ID" ]]; then
    log_record "event=ignored status=skip reason=missing_turn_id"
    exit 0
fi

cd "$CWD" || exit 0

log_record "event=handoff-start status=running"

"$CATCOPY" codex-turn "$THREAD_ID" "$TURN_ID"
STATUS=$?

log_record "event=handoff-finish status=$STATUS"

exit "$STATUS"
